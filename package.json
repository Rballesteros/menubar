    "prepare": "yarn build",
    "test": "jest"
  },
  "types": "lib/index.d.ts",
  "dependencies": {
    "electron-positioner": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/jest": "^30.0.0",
    "electron": "^39.2.7",
    "jest": "^30.2.0",
    "rimraf": "^3.0.2",
    "standard-version": "^8.0.0",
    "ts-jest": "^29.4.6",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.0.0",
